{
  "name": "eyecare",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "api": "npm run dev -w apps/api",
    "mobile": "npm run start -w apps/mobile",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json"
  },
  "overrides": {
    "ajv": "^8.12.0",
    "metro-cache": "~0.83.0",
    "metro-config": "~0.83.0",
    "metro-core": "~0.83.0",
    "metro-file-map": "~0.83.0",
    "metro-runtime": "~0.83.0",
    "metro-source-map": "~0.83.0",
    "metro-transform-plugins": "~0.83.0",
    "metro-transform-worker": "~0.83.0",
    "metro-babel-transformer": "~0.83.0",
    "metro-resolver": "~0.83.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "metro": "^0.83.7",
    "prettier": "^3.2.0",
    "react-native": "0.81.5",
    "typescript": "^5.3.0"
  }
}
